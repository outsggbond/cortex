{
  "roots": [
    "artifacts/audit",
    "artifacts/checkpoints",
    "artifacts/memory"
  ],
  "suffixes": [
    ".json",
    ".jsonl",
    ".log",
    ".pt",
    ".npz",
    ".bin",
    ".safetensors",
    ".pkl",
    ".npy",
