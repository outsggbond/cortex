{
  "prefer_text_if_short": true,
  "audio_energy_threshold": 0.02,
  "image_min_pixels": 2048,
  "video_min_frames": 5,
  "keyword_score_threshold": 0.5,
  "keyword_weights": {
    "text": {
      "question": 2.0,
      "error": 1.5
    },
    "image": {
      "screenshot": 1.2,
      "photo": 1.0
    },
    "audio": {
      "speech": 1.3
    },
    "video": {
      "screenrecord": 1.1
    }
  },
  "allow_fallback_to_candidates": true,
  "safe_mode": {
    "validate_on_update": true,
    "min_modalities": 1
  }
}